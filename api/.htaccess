# Los archivos internos no deben poder abrirse desde el navegador
<FilesMatch "^(config|config\.local|common)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
