Options -Indexes
DirectoryIndex index.html

# Tipos correctos (los módulos de JavaScript exigen el tipo MIME adecuado)
AddType text/javascript .js
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  # el código se revalida siempre (ETag): así nunca se mezclan archivos viejos y nuevos tras una actualización
  <FilesMatch ".(js|css|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
